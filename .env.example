# Copy to .env and fill in. Every variable here is required: settings have no fallback
# for them, so a missing one fails at boot naming itself.
# Avoid "$" in values: Docker Compose interpolates it.
SECRET_KEY=
ALLOWED_HOSTS=*
# Frontend origins, comma separated. Scheme and port included, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

POSTGRES_DB=amandu
POSTGRES_USER=amandu
POSTGRES_PASSWORD=
# Overridden to "db" by docker-compose for the api service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Overridden to redis://redis:6379/0 by docker-compose for the api service.
REDIS_URL=redis://localhost:6379/0

# Image bucket (S3-compatible: MinIO in dev, Cloudflare R2 in production).
# The values below fit `docker compose up`, which also uses the key pair as
# MinIO's root login. In production S3_ENDPOINT and S3_PUBLIC_ENDPOINT are both
# https://<account>.r2.cloudflarestorage.com, S3_PUBLIC_URL is the bucket's
# custom domain, and S3_REGION is left unset ("auto").
# Overridden to http://minio:9000 by docker-compose for the api service.
S3_ENDPOINT=http://localhost:9000
# What upload URLs are signed for: the host the BROWSER reaches the bucket at.
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Base URL images are read from; the object key is appended.
S3_PUBLIC_URL=http://localhost:9000/amandu
S3_BUCKET=amandu
S3_ACCESS_KEY_ID=amandu
S3_SECRET_ACCESS_KEY=amandu-dev-secret
S3_REGION=us-east-1

# Required in production only, which refuses to boot without it: the day per-turn
# charging went live (YYYY-MM-DD). Turns before it are never reported unpaid.
# Development and test default to 2026-10-02.
# BILLING_GO_LIVE=2026-10-02

# Optional (safe defaults in base.py; override in production). Email delivers the
# invitation accept link. Dev prints to the console; production points EMAIL_BACKEND
# at SMTP and fills the host/credentials.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
# INVITATION_ACCEPT_URL=https://app.yourdomain.com/invitations/accept

# What a tenant's owner is told when paying Kyo is due or late, and Kyo's
# WhatsApp (digits, international form) for changes to the team or add-ons.
# KYO_PAYMENT_INSTRUCTIONS="Transferencia a Banco X, cuenta 123, a nombre de Kyo."
# KYO_CONTACT_WHATSAPP=595981000000

# Django admin path, trailing slash included. In production use something
# non-obvious (e.g. gestion-x7k2/): /admin/ is probed by every scanner and the
# admin login has no rate limit.
# ADMIN_URL=admin/

# Web Push. Without these the API runs normally and the app offers no reminders,
# while `manage.py send_reminders` refuses to start rather than sending nothing
# quietly. Generate the pair ONCE with `manage.py vapid_keys` and never again:
# every browser stored the public key when it subscribed, so a new pair orphans
# all of them and each device has to opt in a second time.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.com

# WhatsApp via a self-hosted WAHA (devlikeapro/waha). Without WAHA_URL nothing is
# sent and no message is queued. The session must already be paired (QR) with the
# Kyo number, and send_reminders delivers the queue, a few messages per run.
# WAHA_URL=http://waha:3000
# WAHA_API_KEY=
# WAHA_SESSION=default
# WHATSAPP_NUMBER=+595981000000
