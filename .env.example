# Copy to .env and fill in. Avoid "$" in values: Docker Compose interpolates it.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=*

POSTGRES_DB=amandu
POSTGRES_USER=amandu
POSTGRES_PASSWORD=
# Overridden to "db" by docker-compose for the api service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Overridden to redis://redis:6379/0 by docker-compose for the api service.
REDIS_URL=redis://localhost:6379/0

# MinIO. The endpoint is signed into every presigned URL, so it must be the host the
# browser reaches. In dev add "127.0.0.1 minio" to your /etc/hosts so the same URL
# works from the container and from your browser. In production: https://s3.yourdomain.com
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=amandu-media
